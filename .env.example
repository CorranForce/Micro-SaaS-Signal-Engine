# .env.example

# Gemini API key (required) — powers idea generation, launch kits, and chat
GEMINI_API_KEY=

# Optional Gemini model overrides. Defaults: gemini-flash-latest / gemini-pro-latest
# (stable aliases that won't get deprecated out from under you). Set these to the
# exact model IDs your API key can access. List them with:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY"
GEMINI_MODEL=
GEMINI_MODEL_PRO=

# Secret used to sign session cookies and encrypt stored credentials.
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (In dev, a random secret is auto-generated and persisted under data/.)
SESSION_SECRET=

# Email address allowed to manage API settings (defaults to the project owner)
OPERATOR_EMAIL=

# Resend Integration (launch-kit emails)
RESEND_API_KEY=
# Verified sender for real delivery, e.g. "SaaS Radar <radar@yourdomain.com>".
# The default onboarding@resend.dev sandbox sender only delivers to the
# Resend account owner's own address.
RESEND_FROM=

# Supabase Integration (Durable Cloud Persistence)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service-role key — bypasses Row Level Security. Required ONLY if you use the
# secret_keys routes (POST /api/secrets/seed, GET /api/cron/agent); leave blank
# otherwise. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the scheduled security agent. GET /api/cron/agent requires
# "Authorization: Bearer $CRON_SECRET" and denies every request when unset.
# Set the same value in your Vercel project so its cron scheduler can call it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Apollo.io key — only read by the secret_keys seed route
APOLLO_API_KEY=

# GoDaddy Integration (Domain Registration checks)
GODADDY_API_KEY=
GODADDY_API_SECRET=
