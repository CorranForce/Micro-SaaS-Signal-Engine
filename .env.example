# .env.example

# Gemini API key (required) — powers idea generation, launch kits, and chat
GEMINI_API_KEY=

# Optional Gemini model overrides. The in-code defaults are pinned IDs
# (gemini-3.8-flash); if your key cannot reach them, every generation call
# silently degrades to synthesized placeholder content. Set these to exact model
# IDs your key can access — or to the stable aliases gemini-flash-latest /
# gemini-pro-latest, which always resolve to a current model. List them with:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY"
GEMINI_MODEL=
GEMINI_MODEL_PRO=
GEMINI_MODEL_FAST=

# Secret used to sign session cookies and encrypt stored credentials.
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (In dev, a random secret is auto-generated and persisted under data/.)
SESSION_SECRET=

# Email address allowed to manage API settings (defaults to the project owner).
# Provision the account with: npm run create-operator -- <email>
# No operator is seeded automatically — a committed password hash would be a
# public, offline-crackable credential.
OPERATOR_EMAIL=

# Resend Integration (launch-kit emails)
RESEND_API_KEY=
# Verified sender for real delivery, e.g. "SaaS Radar <radar@yourdomain.com>".
# The default onboarding@resend.dev sandbox sender only delivers to the
# Resend account owner's own address.
RESEND_FROM=

# Supabase Integration (Durable Cloud Persistence)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Used by /api/secrets/seed and /api/cron/agent; never expose
# this to the browser. Falls back to SUPABASE_ANON_KEY when unset.
SUPABASE_SERVICE_ROLE_KEY=

# GoDaddy Integration (Domain Registration checks)
# Optional: availability falls back to an authoritative DNS lookup without them.
# Configure these only if you want live registrar price quotes.
GODADDY_API_KEY=
GODADDY_API_SECRET=

# Shared secret for the hourly security-agent cron (/api/cron/agent).
# Vercel Cron sends it as "Authorization: Bearer $CRON_SECRET".
# The route FAILS CLOSED: if this is unset, every request is rejected with 401.
CRON_SECRET=

# Run the security agent from an in-process node-cron timer instead of Vercel
# Cron. Only useful for long-lived local/self-hosted servers; leave unset on
# Vercel, where vercel.json already schedules it. Requires CRON_SECRET.
ENABLE_LOCAL_CRON=
# Override the URL the local cron calls (default http://127.0.0.1:$PORT/api/cron/agent)
CRON_AGENT_URL=
