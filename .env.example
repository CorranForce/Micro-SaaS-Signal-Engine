# .env.example

# Gemini API key (required) — powers idea generation, launch kits, and chat
GEMINI_API_KEY=

# Optional Gemini model overrides. Set these to the exact model IDs your API
# key can access. List them with:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY"
#
#   GEMINI_MODEL_FAST      typeahead/suggestions + the cron security agent
#                          (default: gemini-3.5-flash)
#   GEMINI_MODEL           idea search, launch kits, chat
#                          (default: gemini-3.5-flash)
#   GEMINI_MODEL_PRO       "High Thinking" search + the deep strategic audit.
#                          Defaults to gemini-3.5-flash — point this at a pro
#                          model if your key has one, otherwise "High Thinking"
#                          only changes thinkingLevel, not the model.
#   GEMINI_MODEL_FALLBACK  last-resort rung when the above are unavailable
#                          (default: gemini-flash-latest, a stable alias)
GEMINI_MODEL_FAST=
GEMINI_MODEL=
GEMINI_MODEL_PRO=
GEMINI_MODEL_FALLBACK=

# Secret used to sign session cookies and encrypt stored credentials.
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (In dev, a random secret is auto-generated and persisted under data/.)
SESSION_SECRET=

# Email address allowed to manage API settings (defaults to the project owner)
OPERATOR_EMAIL=

# Resend Integration (launch-kit emails)
RESEND_API_KEY=
# Verified sender for real delivery, e.g. "SaaS Radar <radar@yourdomain.com>".
# The default onboarding@resend.dev sandbox sender only delivers to the
# Resend account owner's own address.
RESEND_FROM=

# Supabase Integration (Durable Cloud Persistence)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Preferred for server-side writes (secrets seeding, the cron security agent).
# Falls back to SUPABASE_ANON_KEY when unset. Leave the whole Supabase block
# blank to run without it — those routes then return 503 instead of failing.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the scheduled security agent. GET /api/cron/agent requires
# `Authorization: Bearer $CRON_SECRET` and refuses every request while this is
# unset. Vercel Cron sends this header automatically when CRON_SECRET is set in
# the project env. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Optional — only read by POST /api/secrets/seed (operator-only) when seeding
# credentials into Supabase.
APOLLO_API_KEY=

# GoDaddy Integration (Domain Registration checks)
GODADDY_API_KEY=
GODADDY_API_SECRET=
